# Copier ce fichier en `.env` (à la racine du backend) et renseigner les valeurs.
# Ne jamais versionner le fichier `.env`.

# Django
# Générer une clé : python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
# Origines autorisées pour le CSRF (prod), séparées par des virgules : https://app.dahoo.com
CSRF_TRUSTED_ORIGINS=

# Base de données (PostgreSQL)
DB_NAME=dahoo
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Email (optionnel)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# Services tiers (optionnel)
SENTRY_DSN=

# CORS : origines du front autorisées (séparées par des virgules)
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Durée de l'essai gratuit d'une nouvelle organisation, en jours
TRIAL_DAYS=30

# Limitation des requêtes (facultatif) : "<nombre>/<sec|min|hour|day>"
# THROTTLE_ANON=60/min              # visiteurs non connectés (dont l'API publique)
# THROTTLE_PUBLIC_INTEREST=10/hour  # demandes de visite sur une annonce
# THROTTLE_DEMO_REQUEST=5/hour      # formulaire « demander une démo »

# Clé partagée avec le front Next.js (même valeur que DAHOO_PROXY_KEY côté front) : permet au front
# de transmettre l'IP réelle des visiteurs pour la limitation de débit. Générer une longue valeur aléatoire.
INTERNAL_PROXY_KEY=

# Adresse publique du front : liens des quittances, reçus et relevés envoyés par WhatsApp (https en production)
PUBLIC_SITE_URL=http://localhost:3000
# DOCUMENT_LINK_MAX_AGE=34560000   # durée de validité de ces liens, en secondes (400 jours)


# ── Courrier sortant ──────────────────────────────────────────────────────
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=votre-adresse@gmail.com
EMAIL_HOST_PASSWORD=xxxxxxxxxxxxxxxx
EMAIL_USE_TLS=True

# E-mails (Gmail : EMAIL_HOST=smtp.gmail.com, port 587, mot de passe d'application). Sans identifiants, les
# messages s'affichent dans la console. Pas de commentaire après une valeur vide : il serait lu comme valeur.
# Expéditeur, ex. Dahoo <no-reply@dahoo.sn> ; EMAIL_HOST_USER par défaut
DEFAULT_FROM_EMAIL=
EMAIL_REPLY_TO=
# False : tout fonctionne, rien ne part
EMAIL_ENABLED=True
# Recette : tous les messages partent vers cette seule adresse
EMAIL_TEST_RECIPIENT=
