# Copier ce fichier en `.env` (à la racine du backend) et renseigner les valeurs.
# Ne jamais versionner le fichier `.env`.

# Django
# Générer une clé : python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
# Origines autorisées pour le CSRF (prod), séparées par des virgules : https://app.dahoo.com
CSRF_TRUSTED_ORIGINS=

# Base de données (PostgreSQL)
DB_NAME=dahoo
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Email (optionnel)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# Services tiers (optionnel)
SENTRY_DSN=

# CORS : origines du front autorisées (séparées par des virgules)
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Durée de l'essai gratuit d'une nouvelle organisation, en jours
TRIAL_DAYS=30
